{
    "compilerOptions": {
        "target": "ES2020",
        "experimentalDecorators": false,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "strict": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "sourceMap": true
    },
    "include": [
        "*.ts",
        "scripts/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}
